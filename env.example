# HealthKeep frontend production configuration.
# Copy these keys into Vercel Project Settings -> Environment Variables.

# Server-side backend URL used by Next.js route handlers.
# Production should point to the deployed FastAPI backend.
API_BASE_URL=https://healthkeep-api.vercel.app

# Browser-visible API URL kept for compatibility with existing proxy routes.
# Do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=https://healthkeep-api.vercel.app

# Fixed frontend origin. User and CMO must share this origin.
NEXT_PUBLIC_FRONTEND_ORIGIN=https://web-iota-livid-33.vercel.app
NEXT_PUBLIC_PUBLIC_BASE_URL=https://web-iota-livid-33.vercel.app

# Emergency QR links must use a phone-reachable public origin.
NEXT_PUBLIC_EMERGENCY_PUBLIC_BASE_URL=https://web-iota-livid-33.vercel.app

# LINE LIFF public id, if LINE login is enabled.
NEXT_PUBLIC_LIFF_ID=
